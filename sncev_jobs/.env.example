# =============================================================================
# SNCEV Jobs — Variables de entorno
# Copiar a .env y ajustar valores antes de ejecutar
# =============================================================================

# Base de datos PostgreSQL central
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sncev_db
DB_USER=sncev_app
DB_PASSWORD=CAMBIAR_EN_PRODUCCION
DB_SSLMODE=require          # 'require' en producción, 'disable' en desarrollo local

# Umbrales de alerta (porcentajes)
META_COBERTURA_PCT=95
UMBRAL_ALERTA_PCT=80

# Notificaciones (opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Monitoreo de errores (opcional)
SENTRY_DSN=https://xxx@sentry.io/yyy

# Entorno
ENTORNO=produccion          # produccion | desarrollo | staging
METRICS_PORT=9090

# Grafana (solo docker-compose)
GRAFANA_PASSWORD=CAMBIAR_EN_PRODUCCION
