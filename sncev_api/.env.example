# ── Aplicación ───────────────────────────────────────────────────────────────
ENVIRONMENT=development                  # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]
TRUST_FORWARDED_FOR=false                # true solo detrás de un proxy/gateway de confianza
PROMETHEUS_ENABLED=false

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sncev_app:CAMBIAR_EN_PRODUCCION@db:5432/sncev_db
DB_SSL=                                   # '' | require | verify-full (producción: require)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Claves (generar con: python scripts/generar_claves.py certs) ────────────
AES_KEY_HEX=
HASH_PEPPER_HEX=
JWT_PRIVATE_KEY_PATH=/app/certs/private.pem
JWT_PUBLIC_KEY_PATH=/app/certs/public.pem
FIRMA_PRIVATE_KEY_PATH=/app/certs/firma_private.pem
FIRMA_PUBLIC_KEY_PATH=/app/certs/firma_public.pem

# ── Almacenamiento local de PDFs/exportaciones ──────────────────────────────
STORAGE_DIR=/app/storage

# ── Sesiones ─────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=8
MFA_SESSION_EXPIRE_MIN=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
RESET_PASSWORD_MINUTES=30
FRONTEND_RESET_URL=https://portal.sncev.gob.mx/restablecer
