# ── Aplicación ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
TRUST_FORWARDED_FOR=false
PROMETHEUS_ENABLED=false

# ── Base de datos ────────────────────────────────────────────────────────────
DB_SSL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Claves (generar con: python scripts/generar_claves.py certs) ────────────
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
FIRMA_PRIVATE_KEY_PATH=./certs/firma_private.pem
FIRMA_PUBLIC_KEY_PATH=./certs/firma_public.pem

# ── Almacenamiento local de PDFs/exportaciones ──────────────────────────────
STORAGE_DIR=./storage

# ── Sesiones ─────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=8
MFA_SESSION_EXPIRE_MIN=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=30
RESET_PASSWORD_MINUTES=30
FRONTEND_RESET_URL=https://portal.sncev.gob.mx/restablecer
AES_KEY_HEX=3fd0e0bf606db588949f7a3680948a3c0a7768d7bc369e29217e055841250e19
HASH_PEPPER_HEX=88c0868cb47c953b336d184ff1dbef03666956473f11093ef34f0f86ff83b973
DATABASE_URL=postgresql://sncev_app:CAMBIAR_EN_PRODUCCION@127.0.0.1:5432/sncev_db
